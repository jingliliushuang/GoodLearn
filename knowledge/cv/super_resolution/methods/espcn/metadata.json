{
  "id": "espcn",
  "title": "ESPCN",
  "category": "cnn",
  "description": "Efficient Sub-Pixel Convolutional Neural Network，亚像素卷积实时超分",
  "backend": "opencv_dnn_superres",
  "algorithm": "espcn",
  "scale": 2,
  "weights": [
    "ESPCN_x2.pb"
  ],
  "requirements": [
    "opencv-contrib-python"
  ],
  "inference_enabled": true,
  "params_schema": [
    {
      "name": "scale",
      "label": "放大倍率",
      "type": "readonly",
      "default": 2,
      "description": "当前权重仅支持 x2。"
    }
  ],
  "input_spec": {
    "kind": "single_image",
    "count": 1,
    "media_type": "image",
    "description": "输入单张图像"
  },
  "output_spec": {
    "kind": "single_image",
    "count": 1,
    "media_type": "image",
    "description": "输出单张图像"
  }
}
