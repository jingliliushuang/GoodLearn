{
  "id": "ransac_homography",
  "title": "RANSAC Homography",
  "description": "基于特征匹配 + RANSAC 估计单应矩阵",
  "category": "traditional",
  "backend": "opencv",
  "inference_enabled": true,
  "requirements": [],
  "weights": [],
  "params_schema": [
    {
      "name": "ratio",
      "label": "Ratio Test",
      "type": "number",
      "default": 0.75,
      "min": 0.5,
      "max": 0.95,
      "step": 0.05
    },
    {
      "name": "ransac_threshold",
      "label": "RANSAC 阈值",
      "type": "number",
      "default": 5.0,
      "min": 1.0,
      "max": 20.0,
      "step": 0.5
    }
  ],
  "input_spec": {
    "kind": "image_pair",
    "count": 2,
    "media_type": "image",
    "description": "输入两张待匹配图像"
  },
  "output_spec": {
    "kind": "match_visualization",
    "count": 1,
    "media_type": "image",
    "description": "输出带匹配连线的可视化图像和匹配指标"
  }
}
