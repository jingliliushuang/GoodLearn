{
  "id": "sift",
  "title": "SIFT",
  "description": "尺度不变特征变换，经典局部特征",
  "category": "traditional",
  "backend": "opencv_sift",
  "inference_enabled": true,
  "requirements": [],
  "weights": [],
  "params_schema": [
    {
      "name": "ratio",
      "label": "Lowe Ratio",
      "type": "number",
      "default": 0.75,
      "min": 0.5,
      "max": 0.95,
      "step": 0.05,
      "description": "Ratio test 阈值，越小匹配越严格。"
    }
  ],
  "input_spec": {
    "kind": "image_pair",
    "count": 2,
    "media_type": "image",
    "description": "输入两张待匹配图像"
  },
  "output_spec": {
    "kind": "match_visualization",
    "count": 1,
    "media_type": "image",
    "description": "输出带匹配连线的可视化图像和匹配指标"
  }
}
