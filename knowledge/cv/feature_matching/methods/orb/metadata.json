{
  "id": "orb",
  "title": "ORB",
  "description": "快速二进制特征，适合实时场景",
  "category": "traditional",
  "backend": "opencv",
  "inference_enabled": true,
  "requirements": [],
  "weights": [],
  "params_schema": [
    {
      "name": "ratio",
      "label": "Ratio Test",
      "type": "number",
      "default": 0.75,
      "min": 0.5,
      "max": 0.95,
      "step": 0.05
    },
    {
      "name": "nfeatures",
      "label": "最大特征数",
      "type": "number",
      "default": 500,
      "min": 100,
      "max": 5000,
      "step": 100
    }
  ],
  "input_spec": {
    "kind": "image_pair",
    "count": 2,
    "media_type": "image",
    "description": "输入两张待匹配图像"
  },
  "output_spec": {
    "kind": "match_visualization",
    "count": 1,
    "media_type": "image",
    "description": "输出带匹配连线的可视化图像和匹配指标"
  }
}
