{
  "id": "denoise_standard_experiment",
  "title": "图像去噪标准实验",
  "description": "通过生成含噪图像、执行去噪方法、计算评价指标，完成标准图像去噪实验。",
  "input_type": "single_image",
  "stages": {
    "dataset_generation": {
      "enabled": true,
      "title": "测试集生成",
      "description": "从干净图像生成含噪测试图像。",
      "methods": [
        {
          "id": "gaussian_noise",
          "title": "高斯噪声",
          "description": "向图像添加均值为 0 的高斯噪声。",
          "params_schema": [
            {
              "name": "sigma",
              "label": "噪声标准差",
              "type": "number",
              "default": 25,
              "min": 1,
              "max": 75,
              "step": 1,
              "description": "sigma 越大，噪声越强。"
            }
          ]
        },
        {
          "id": "salt_pepper_noise",
          "title": "椒盐噪声",
          "description": "随机将部分像素置为黑色或白色。",
          "params_schema": [
            {
              "name": "amount",
              "label": "噪声比例",
              "type": "number",
              "default": 0.03,
              "min": 0.001,
              "max": 0.2,
              "step": 0.001,
              "description": "值越大，被污染的像素越多。"
            }
          ]
        },
        {
          "id": "speckle_noise",
          "title": "斑点噪声",
          "description": "乘性噪声，常用于模拟成像传感器噪声。",
          "params_schema": [
            {
              "name": "sigma",
              "label": "噪声强度",
              "type": "number",
              "default": 0.1,
              "min": 0.01,
              "max": 0.5,
              "step": 0.01,
              "description": "值越大，斑点噪声越明显。"
            }
          ]
        }
      ]
    },
    "inference": {
      "enabled": true,
      "title": "模型推理",
      "description": "选择当前去噪节点下的可运行方法进行恢复。",
      "methods_from": "methods"
    },
    "evaluation": {
      "enabled": true,
      "title": "结果评价",
      "description": "比较 clean 图像和 recovered 图像，计算评价指标。",
      "metrics": [
        {
          "id": "mse",
          "title": "MSE",
          "description": "均方误差，越低越好。"
        },
        {
          "id": "psnr",
          "title": "PSNR",
          "description": "峰值信噪比，越高越好。"
        },
        {
          "id": "ssim",
          "title": "SSIM",
          "description": "结构相似性，越接近 1 越好。"
        },
        {
          "id": "runtime_ms",
          "title": "运行时间",
          "description": "模型推理耗时。"
        }
      ]
    }
  }
}
